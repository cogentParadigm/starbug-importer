{
  "name": "starbug/importer",
  "type": "library",
  "description": "Starbug import pipeline.",
  "keywords": [
    "php",
    "starbug",
    "import",
    "spreadsheet"
  ],
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "Ali Gangji",
      "homepage": "https://github.com/cogentParadigm"
    }
  ],
  "extra": {
    "starbug": {
      "type": "module",
      "namespace": "Starbug\\Importer"
    }
  },
  "require": {
    "php": ">=8.0",
    "psr/simple-cache": "^1.0 || ^2.0 || ^3.0",
    "ext-yaml": "*",
    "php-di/php-di": "^7.0",
    "psr/container": "^1.0|^2.0",
    "psr/log": "^1.0|^2.0|^3.0",
    "phpoffice/phpspreadsheet": "^1.12"
  },
  "autoload": {
    "psr-4": {
      "Starbug\\Importer\\": "src/"
    }
  }
}
